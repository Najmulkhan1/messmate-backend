model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  avatar         String?
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  canAddBazaar   Boolean  @default(false)
  depositBalance Decimal  @default(0) @db.Decimal(10, 2)

  mess          Mess?          @relation(fields: [messId], references: [id])
  messId        String?
  meals         Meal[]
  bazaars       Bazaar[]
  payments      Payment[]
  deposits      Deposit[]
  notifications Notification[]
  managedMess   Mess[]         @relation("MessManager")

  @@map("users")
}
